<?xml version="1.0" encoding="UTF-8"?>
<!--
  Via impressa da ordem de serviço: o papel que fica com o cliente.

  Segue o mesmo vocabulário das telas — placa em destaque, serviços e peças na
  mesma tabela e totais fechando à direita. Fonte lógica do Java (SansSerif e
  Monospaced), sem extensão de fonte instalada: a oficina imprime em qualquer
  máquina, e dinheiro em monoespaçado alinha coluna sem depender de tabela.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ordem-servico" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="numeroOrdem" class="java.lang.String"/>
    <parameter name="abertaEm" class="java.lang.String"/>
    <parameter name="status" class="java.lang.String"/>
    <parameter name="cliente" class="java.lang.String"/>
    <parameter name="documentoCliente" class="java.lang.String"/>
    <parameter name="telefoneCliente" class="java.lang.String"/>
    <parameter name="placa" class="java.lang.String"/>
    <parameter name="veiculo" class="java.lang.String"/>
    <parameter name="relatoProblema" class="java.lang.String"/>
    <parameter name="totalServicos" class="java.math.BigDecimal"/>
    <parameter name="totalPecas" class="java.math.BigDecimal"/>
    <parameter name="total" class="java.math.BigDecimal"/>
    <parameter name="contaSituacao" class="java.lang.String"/>
    <parameter name="contaDetalhe" class="java.lang.String"/>

    <field name="tipo" class="java.lang.String"/>
    <field name="descricao" class="java.lang.String"/>
    <field name="quantidade" class="java.lang.String"/>
    <field name="valorUnitario" class="java.math.BigDecimal"/>
    <field name="total" class="java.math.BigDecimal"/>

    <title>
        <band height="176">
            <staticText>
                <reportElement x="0" y="0" width="300" height="22"/>
                <textElement>
                    <font fontName="SansSerif" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[OFICINA SAMPAIO]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="22" width="300" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <text><![CDATA[Ordem de serviço]]></text>
            </staticText>
            <textField>
                <reportElement x="335" y="0" width="200" height="18"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["OS " + $P{numeroOrdem}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="335" y="20" width="200" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Aberta em " + $P{abertaEm}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="42" width="535" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="0" y="52" width="260" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[CLIENTE]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="64" width="260" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{cliente}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="80" width="260" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{documentoCliente} + "  ·  " + $P{telefoneCliente}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="275" y="52" width="260" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[VEÍCULO]]></text>
            </staticText>
            <!-- Altura folgada de propósito: texto que não cabe na altura do
                 elemento não é impresso pequeno nem cortado — o JasperReports
                 simplesmente não o desenha. Courier em corpo 11 precisa de mais
                 que os 18pt que pareciam suficientes. -->
            <textField>
                <reportElement x="275" y="60" width="100" height="22"/>
                <box padding="2">
                    <pen lineWidth="1.0"/>
                </box>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{placa}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="64" width="155" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{veiculo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="380" y="80" width="155" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Situação: " + $P{status}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="104" width="535" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[PROBLEMA RELATADO PELO CLIENTE]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="116" width="535" height="30"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{relatoProblema}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="156" width="535" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[SERVIÇOS E PEÇAS]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement x="0" y="0" width="55" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[TIPO]]></text>
            </staticText>
            <staticText>
                <reportElement x="55" y="0" width="245" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[DESCRIÇÃO]]></text>
            </staticText>
            <staticText>
                <reportElement x="300" y="0" width="55" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[QTD.]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[UNITÁRIO]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="15" width="535" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="17">
            <textField>
                <reportElement x="0" y="2" width="55" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="55" y="2" width="245" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="2" width="55" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantidade}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="360" y="2" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{valorUnitario}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="2" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="16" width="535" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.25" lineColor="#B0B0B0"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <summary>
        <band height="200">
            <staticText>
                <reportElement x="300" y="8" width="100" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Serviços]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="405" y="8" width="130" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalServicos}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="22" width="100" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[Peças]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="405" y="22" width="130" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{totalPecas}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="300" y="38" width="235" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="300" y="42" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement x="405" y="42" width="130" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="74" width="535" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[CONTA]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="86" width="535" height="14"/>
                <textElement>
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{contaSituacao} + "  —  " + $P{contaDetalhe}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="150" width="230" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="154" width="230" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <text><![CDATA[Assinatura do cliente]]></text>
            </staticText>
            <line>
                <reportElement x="305" y="150" width="230" height="1"/>
            </line>
            <staticText>
                <reportElement x="305" y="154" width="230" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <text><![CDATA[Responsável pela oficina]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
