<?xml version="1.0" encoding="UTF-8"?>
<!--
  Extrato do caixa no período. Entrada e saída em colunas separadas e a coluna que
  não se aplica fica vazia — em papel isso se lê melhor que um sinal antes do
  número. O saldo é entradas menos saídas, calculado pelo domínio.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="caixa" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="periodo" class="java.lang.String"/>
    <parameter name="entradas" class="java.math.BigDecimal"/>
    <parameter name="saidas" class="java.math.BigDecimal"/>
    <parameter name="saldo" class="java.math.BigDecimal"/>

    <field name="ocorridaEm" class="java.lang.String"/>
    <field name="descricao" class="java.lang.String"/>
    <field name="entrada" class="java.math.BigDecimal"/>
    <field name="saida" class="java.math.BigDecimal"/>

    <title>
        <band height="92">
            <staticText>
                <reportElement x="0" y="0" width="300" height="20"/>
                <textElement>
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[CAIXA]]></text>
            </staticText>
            <staticText>
                <reportElement x="335" y="2" width="200" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Oficina Sampaio]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="22" width="535" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Período de " + $P{periodo}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="40" width="535" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="0" y="50" width="150" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ENTRADAS]]></text>
            </staticText>
            <!-- Alturas com folga: o JasperReports não desenha texto que não cabe
                 na altura declarada, e um saldo que desaparece é pior que um
                 relatório que nem abre. -->
            <textField pattern="R$ #,##0.00">
                <reportElement x="0" y="60" width="150" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{entradas}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="175" y="50" width="150" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[SAÍDAS]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement x="175" y="60" width="150" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{saidas}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="350" y="50" width="185" height="10"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[SALDO]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement x="350" y="58" width="185" height="24"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{saldo}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement x="0" y="0" width="110" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[QUANDO]]></text>
            </staticText>
            <staticText>
                <reportElement x="115" y="0" width="240" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[LANÇAMENTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="360" y="0" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ENTRADA]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[SAÍDA]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="15" width="535" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="17">
            <textField>
                <reportElement x="0" y="2" width="110" height="12"/>
                <textElement>
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ocorridaEm}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="115" y="2" width="240" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{descricao}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="360" y="2" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{entrada}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00" isBlankWhenNull="true">
                <reportElement x="450" y="2" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{saida}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="16" width="535" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.25" lineColor="#B0B0B0"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="435" y="6" width="100" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="46">
            <line>
                <reportElement x="300" y="4" width="235" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="280" y="10" width="120" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[SALDO DO PERÍODO]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement x="405" y="10" width="130" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{saldo}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
