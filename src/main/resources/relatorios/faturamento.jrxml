<?xml version="1.0" encoding="UTF-8"?>
<!--
  Faturamento do período: o que a oficina recebeu, linha por linha, com o total
  fechando embaixo. O total vem calculado pela aplicação sobre as mesmas linhas
  que estão listadas, então corpo e rodapé nunca discordam.
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="faturamento" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="periodo" class="java.lang.String"/>
    <parameter name="recebimentos" class="java.lang.Long"/>
    <parameter name="total" class="java.math.BigDecimal"/>

    <field name="recebidoEm" class="java.lang.String"/>
    <field name="numeroOrdem" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="forma" class="java.lang.String"/>
    <field name="valor" class="java.math.BigDecimal"/>

    <title>
        <band height="86">
            <staticText>
                <reportElement x="0" y="0" width="300" height="20"/>
                <textElement>
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[FATURAMENTO]]></text>
            </staticText>
            <staticText>
                <reportElement x="335" y="2" width="200" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Oficina Sampaio]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="22" width="535" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Período de " + $P{periodo}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="40" width="535" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>

            <staticText>
                <reportElement x="0" y="50" width="140" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[RECEBIMENTOS]]></text>
            </staticText>
            <!-- Altura com folga: texto que não cabe na altura declarada não é
                 desenhado pelo JasperReports, e um total que desaparece do
                 relatório é pior que um relatório que não abre. -->
            <textField>
                <reportElement x="0" y="60" width="140" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[String.valueOf($P{recebimentos})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="160" y="50" width="200" height="10"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL RECEBIDO]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement x="160" y="60" width="200" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Monospaced" size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement x="0" y="0" width="110" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[RECEBIDO EM]]></text>
            </staticText>
            <staticText>
                <reportElement x="115" y="0" width="70" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[ORDEM]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="0" width="170" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[CLIENTE]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="0" width="80" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[FORMA]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7" isBold="true"/>
                </textElement>
                <text><![CDATA[VALOR]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="15" width="535" height="1"/>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="17">
            <textField>
                <reportElement x="0" y="2" width="110" height="12"/>
                <textElement>
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{recebidoEm}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="115" y="2" width="70" height="12"/>
                <textElement>
                    <font fontName="Monospaced" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{numeroOrdem}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="190" y="2" width="170" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="2" width="80" height="12"/>
                <textElement>
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{forma}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="450" y="2" width="85" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="Monospaced" size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="16" width="535" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.25" lineColor="#B0B0B0"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="435" y="6" width="100" height="12"/>
                <textElement textAlignment="Right">
                    <font fontName="SansSerif" size="7"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="40">
            <line>
                <reportElement x="300" y="4" width="235" height="1"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
            <staticText>
                <reportElement x="300" y="10" width="100" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL]]></text>
            </staticText>
            <textField pattern="R$ #,##0.00">
                <reportElement x="405" y="10" width="130" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="Monospaced" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{total}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
